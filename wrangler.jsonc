{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "website",
	"main": "@tanstack/react-start/server-entry",
	"compatibility_date": "2026-10-19",
	"keep_vars": true,
	"workers_dev": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 0.1,
		},
	},
}
